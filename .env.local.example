# MongoDB connection string
MONGODB_URI=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Super admin credentials (not stored in the database)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Vercel Blob storage (for direct-to-storage uploads of large report files)
# Create a Blob store in the Vercel dashboard and copy its token, or run:
#   npx vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
